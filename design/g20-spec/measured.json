 "method": {
  "glyph_box": "tools/g20spec/measure.py --what glyphs: the panel box is warped out of the original photo at 8x panel resolution (Lanczos), blurred by n/6, thresholded at the midpoint between the 5th and 99.5th percentile of the ink channel (max(RGB) for light text, 255-min(RGB) for dark glyphs on the sign, R-max(G,B) for the red ring), then 8-connected components.",
  "line_width": "half-max of the column-mean profile across the line, 12x supersample",
  "circle": "least-squares circle through the red-ring ink; r_outer / r_inner are the 99th / 1st percentile of the pixel distance from the fitted centre",
  "uncertainty": "each rect model has an rms of ~1 panel px over the whole panel, so a single edge is +-1 px; a difference measured inside one crop (cap height, advance, line thickness) is good to about +-0.3 px"
 },

