# build output and the BMW oap-sdk (not redistributable: the Store makes it on the car)
dist/
oap-sdk/
*.log
bench/.data/
# the emulator's saved settings (kit/tools/emu.js)
preview/
__pycache__/
# agent worktrees and local tool state
.claude/

# third-party reference photos (not ours to publish), and work-in-progress bake output.
# No trailing slash: agent worktrees symlink both from the main checkout, and a pattern ending in "/"
# matches only a real directory, never a symlink, so the photos would show as untracked there.
reference
bake/work

# The documentation lives outside the repository (the Store refuses a repository archive over 64 MiB).
# No trailing slash, as above: agent worktrees symlink it from the main checkout.
docs
