  "settings": [
    {
      "key": "tripMark",
      "label": "TRIP = позначка / TRIP = mark",
      "type": "bool",
      "default": true,
      "_about": "road TS: the stalk's TRIP button (bit 0x40 of Light.IndicatorSteeringColumn.operationColumnStalks, seen on the car 2026-11-18) is also a mark: the rising edge only. Read only."
    },
    {
      "key": "lang",
      "label": "Мова / Language",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Авто"
        ],
        [
          "uk",
          "Українська"
        ],
        [
          "en",
          "English"
        ]
      ],
      "_about": "shared/lang.js: auto = the head unit's (--currentLanguage at start) when it is uk or en, else Ukrainian. Only the rows the app writes follow it; the menu's fixed labels are the package's own."
    }
  ],
  "config": {
    "_about": "READ ONLY. fixes-1121 CR: one recording records one choice (the RECSET row, settings key recSet): RV S19, CAM S20, CRUISE S21, NAV S22 (apps/rv_recorder/rv_fields.js); only the chosen set's interfaces are subscribed. config.rv: summaryS (seconds into a recording at which the log says which sources spoke), hubPauseMs (the pause between two interfaces being subscribed). config.recorder: shared/signal_recorder.js, as Signal Probe's: files of fileRawKB of text in data/rec/, the oldest removed past quotaMB (the app's disk limit is 20 MiB with its log), maxEntries of a list (a source's own recEntries is smaller).",
    "rv": {
      "summaryS": [
        30,
        120,
        600
      ],
      "hubPauseMs": 120
    },
    "recorder": {
      "fileRawKB": 4096,
      "quotaMB": 15,
      "flushMs": 1000,
      "maxQueueKB": 2048,
      "gzip": true,
      "maxEntries": 16
    }
  }
