  "config": {
    "target": "panel",
    "statusName": "Cluster",
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "location": {
      "lat": 50.45,
      "lon": 30.52
    },
    "utcOffsetMinutes": null,
    "waze": {
      "comment": "Show Waze map inside the theme (shared/waze.js): waze-on-cluster's status file (read every second) and its control socket (one short 'start' command, then closed). Paths from waze-on-cluster 0.9.3.",
      "status": "/run/waze-on-cluster/status.json",
      "control": "/dev/shm/waze-on-cluster/ctl.sock"
    },
    "_comment": "target panel: the whole 1920x720 instrument cluster, drawn over BMW's gauges. socketPath: cluster-render's documented default. location and utcOffsetMinutes: as in HUD Widgets (the clock box). tankLitres: the fuel gauge's full mark (the car sends litres, not the tank size; a G01 X3 holds 65). engine: the peak crank torque (Nm) and power (kW) the {{torquePct}} and {{powerPct}} tokens count from (an M40i: 500 Nm, 285 kW / 382 hp).",
    "dme": {
      "comment": "Boost from the engine unit (DME, ecu 18) over read-only UDS 0x22, only while the sport display sends no boost and a boost readout is shown. Absolute kPa, the outside air pressure (baro) is subtracted. Candidates tried in order, the first plausible one wins. From cauliflowermossgrape's car_vitals (MIT). Intake air temperature the same way (config.dme.intake, every 2 s, only while an intake readout shows); candidates from cruzen991/Cluster's signal table (MIT), unverified on this car.",
      "ecu": 18,
      "boost": [
        {
          "did": "F470",
          "bytes": 2,
          "at": 3,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x70 boost pressure control: actual boost pressure sensor A (absolute), 1/32 kPa"
        },
        {
          "did": "F487",
          "bytes": 2,
          "at": 1,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x87 intake manifold absolute pressure sensor A, 1/32 kPa"
        },
        {
          "did": "F40B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD PID 0x0B intake manifold absolute pressure, kPa (max 255 = 1.5 bar boost)"
        },
        {
