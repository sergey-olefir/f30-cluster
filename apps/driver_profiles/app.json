{
  "id": "driver_profiles",
  "title": "Driver Profiles",
  "description": "The car's driver profiles: guest, valet and the seven personal slots with their details; add a local (offline) profile, rename it, copy Guest's settings into it, set its avatar (one of BMW's 15, or your own picture), delete it. Every write asks first.",
  "version": "0.2.0",
  "vendor": "custom",
  "loggingId": "OADP",
  "iconGlyph": "DP",
  "mguHmi": ["ID7"],
  "signals": {
    "de.bmw.infotainment.personalization.UserAccountManager": {
      "_instances": "de.bmw.infotainment.personalization.UserAccountManager",
      "_methods": ["createUserAccount", "removeUserAccount", "copyGuestData"]
    },
    "de.bmw.infotainment.personalization.UserAccount": {
      "_instances": "*",
      "id": "r",
      "name": "rws",
      "firstName": "rs",
      "type": "r",
      "gcid": "rs",
      "protection": "rs",
      "creationDate": "r",
      "lastLoginDate": "rs",
      "synchronizationEnabled": "rs",
      "connectedDriveUsername": "rs",
      "emailAddress": "rs",
      "avatarType": "rws",
      "avatar": "rws",
      "_broadcasts": ["requestUpdateConnectedDriveCredentials"]
    },
    "de.bmw.infotainment.personalization.UserAccountIntra": {
      "_instances": "*",
      "_methods": ["getCopyGuestTimestamp"],
      "_optional": "when Guest's settings were copied into a profile"
    },
    "de.bmw.infrastructure.DriverSelectionModule": {
      "_instances": "1",
      "piaProfileId": "rs",
      "BdcIdentityMappingTable": "rs",
      "_optional": "the active PIA profile number and which key maps to which PIA profile"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "_optional": "the engine-off check before a write"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "DataPowerTrain2": "s",
      "_optional": "the gear-in-P check before a write"
    },
    "de.bmw.infrastructure.Pia": {
      "PIATransaction": "s",
      "_optional": "the no-PIA-job-running check before a write"
    }
  },
