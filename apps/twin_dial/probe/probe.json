      "statusBordcomputerTravelStart": "rs",
      "statusBordcomputerStatus2": "rs",
      "statusKombiExternalDisplay": "rs",
      "dataInstrumentPack": "rs",
      "statusKombiSelection": "rs",
      "statusKombiSelectionAvailability": "rs",
      "statusConfigurationKombi5": "rs",
      "_probe": "P1 statusActiveCCMessage; P1 statusMenuCCMessage; P11 statusConfigurationKombi5; P11 statusKombiSelection; P11 statusKombiSelectionAvailability; P3 statusRangeTankStatus; P4 statusBordcomputerAverage; P4 statusBordcomputerStatus2; P4 statusBordcomputerTravelData; P4 statusBordcomputerTravelStart; P5 statusKombiExternalDisplay; P6 dataInstrumentPack"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
