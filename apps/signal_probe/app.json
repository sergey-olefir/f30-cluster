      "hubPauseMs": 120
    },
    "_about": "READ ONLY. config.probe.summaryS: seconds after a set is switched on at which its summary (and, at 120 s, one getter ask per silent field) is logged; hubPauseMs: the pause between two interfaces being subscribed."
  }
