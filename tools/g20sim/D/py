#!/bin/sh
# Run Python with the bake's dependencies (opencv, numpy, pillow, scipy).
ROOT=$(cd "$(dirname "$0")/../../.." && pwd)
UV_CACHE_DIR=${UV_CACHE_DIR:-${F30_MAIN:-$ROOT}/bake/work/.uvcache} exec uv run -q --no-project --with opencv-python-headless --with numpy --with pillow --with scipy python "$@"
