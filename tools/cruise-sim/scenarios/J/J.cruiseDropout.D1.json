{
 "id": "J.cruiseDropout.D1",
 "family": "J",
 "extends": "D.brake",
 "name": "cruiseDropout during D.brake, at the worst time",
 "description": "D.brake (v=120, dv=40, a=-1.5, tb=20) and the cruise drops out by itself (the car coasts); the injection time is swept and the worst outcome counts.",
 "scope": "warnOnly",
 "params": {
  "v": 120,
  "dv": 40,
  "a": -1.5,
  "tb": 20,
  "tf": 14
 },
 "events+": [
  {
   "t": "=tf",
   "kind": "fault",
   "fault": "cruiseDropout"
  }
 ],
 "sweep": {
  "tf": [
   14,
   16,
   18,
   19,
   20,
   21,
   22,
   24
  ],
  "v": [
   90,
   120
  ]
 },
 "where": "=v-dv >= 30",
 "worstOver": [
  "tf"
 ],
 "decide": [
  "collision",
  "missedWarning",
  "warnLeadTime_s"
 ]
}
