{
 "id": "J.sensorBlind.B",
 "family": "J",
 "extends": "B.approach",
 "name": "sensorBlind during B.approach, at the worst time",
 "description": "B.approach (v=120, dv=40, g0=250) and the sensor goes blind for 5 s; the injection time is swept and the worst outcome counts.",
 "scope": "warnOnly",
 "params": {
  "v": 120,
  "dv": 40,
  "g0": 250,
  "tf": 5
 },
 "events+": [
  {
   "t": "=tf",
   "kind": "fault",
   "fault": "sensorBlind",
   "duration": 5
  }
 ],
 "sweep": {
  "tf": [
   5,
   10,
   15,
   20,
   25,
   30,
   35
  ],
  "v": [
   90,
   120
  ]
 },
 "worstOver": [
  "tf"
 ],
 "decide": [
  "collision",
  "missedWarning",
  "warnLeadTime_s",
  "faultDetectDelay_s"
 ]
}
