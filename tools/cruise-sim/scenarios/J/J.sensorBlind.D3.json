{
 "id": "J.sensorBlind.D3",
 "family": "J",
 "extends": "D.brake.hard",
 "name": "sensorBlind during D.brake.hard, at the worst time",
 "description": "D.brake.hard (v=120, dv=40, a=-3, tb=20) and the sensor goes blind for 5 s; the injection time is swept and the worst outcome counts.",
 "scope": "warnOnly",
 "params": {
  "v": 120,
  "dv": 40,
  "a": -3,
  "tb": 20,
  "tf": 14
 },
 "events+": [
  {
   "t": "=tf",
   "kind": "fault",
   "fault": "sensorBlind",
   "duration": 5
  }
 ],
 "sweep": {
  "tf": [
   14,
   16,
   18,
   19,
   20,
   21,
   22,
   24
  ],
  "v": [
   90,
   120
  ]
 },
 "where": "=v-dv >= 30",
 "worstOver": [
  "tf"
 ],
 "decide": [
  "collision",
  "missedWarning",
  "warnLeadTime_s",
  "faultDetectDelay_s"
 ]
}
